# SATORN Application - Environment Configuration Template
# Copy this file to .env and update values for your environment

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satorn
DB_USER=satorn_user
DB_PASSWORD=satorn_password

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=10s
# Set true only if you want /actuator/health to fail when Redis is unreachable/slow.
MANAGEMENT_HEALTH_REDIS_ENABLED=false

# ============================================
# JWT CONFIGURATION
# ============================================
# IMPORTANT: Change this to a random, secure string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-environment

# ============================================
# AI SERVICE API KEYS
# ============================================
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=

# ============================================
# TAVILY SEARCH API
# ============================================
# Tavily API key for evidence gathering
TAVILY_API_KEY=

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Spring profile: development, production
SPRING_PROFILE=development

# Backend container port when using docker compose --profile fullstack
APP_PORT=8080

# CORS origins (comma-separated). Use * for local-only open CORS.
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Enable periodic RSS auto discovery/processing scheduler (false = manual trigger only).
RSS_MONITORING_AUTO_RUN_ENABLED=false

# Bypass host/system proxy when fetching RSS feeds and scraping articles.
NETWORK_BYPASS_SYSTEM_PROXY=true

# Allow RSS fallback processing when only feed summaries are available.
RSS_MONITORING_MIN_RSS_SUMMARY_LENGTH=80

# Claim extraction safeguards to prevent queue stalls on long LLM calls.
AI_CLAIM_EXTRACTION_MAX_INPUT_CHARS=6000
AI_CLAIM_EXTRACTION_TIMEOUT_SECONDS=90

# Optional JVM flags for backend container
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# ============================================
# DOCKER CONFIGURATION
# ============================================
# Compose project name
COMPOSE_PROJECT_NAME=satorn
